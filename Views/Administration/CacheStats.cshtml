@model List<CacheEntryInfo>
@{
    ViewData["Title"] = "Cache Stats";
    var totalEntries = ViewBag.TotalEntries as int? ?? 0;
    var totalHits = ViewBag.TotalHits as long? ?? 0;
    var totalMisses = ViewBag.TotalMisses as long? ?? 0;
    var isConnected = ViewBag.IsConnected as bool? ?? false;
    var totalRequests = totalHits + totalMisses;
}

<div class="container-fluid py-4">
    <h1 class="mb-4">
        <i class="bi bi-database-gear me-2"></i>Estado del Cache
    </h1>

    @if (TempData["CacheMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            @TempData["CacheMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["CacheError"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @TempData["CacheError"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Redis Status</div>
                    @if (isConnected)
                    {
                        <span class="badge bg-success fs-6 px-3 py-2">
                            <i class="bi bi-check-circle me-1"></i>Conectado
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-warning text-dark fs-6 px-3 py-2">
                            <i class="bi bi-exclamation-triangle me-1"></i>Desconectado
                        </span>
                    }
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Keys en Cache</div>
                    <div class="fs-2 fw-bold text-primary">@totalEntries</div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Solicitudes</div>
                    <div class="fs-2 fw-bold text-info">@totalRequests</div>
                    <div class="mt-1">
                        <span class="text-success small">@totalHits hits</span>
                        <span class="text-danger small ms-2">@totalMisses misses</span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <div class="text-muted small mb-1">Hit Rate</div>
                    @if (totalRequests > 0)
                    {
                        var pct = totalHits * 100.0 / totalRequests;
                        <div class="fs-2 fw-bold @(pct > 80 ? "text-success" : pct > 50 ? "text-warning" : "text-danger")">
                            @($"{pct:F1}%")
                        </div>
                    }
                    else
                    {
                        <div class="fs-2 fw-bold text-muted">-</div>
                    }
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-white d-flex justify-content-between align-items-center py-3">
            <h5 class="mb-0"><i class="bi bi-list-columns me-2"></i>Cache Keys</h5>
            <button class="btn btn-outline-secondary btn-sm" onclick="location.reload()">
                <i class="bi bi-arrow-clockwise me-1"></i>Recargar
            </button>
        </div>
        <div class="card-body p-0">
            @if (Model.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox fs-1 text-muted"></i>
                    <p class="text-muted mt-2 mb-0">No hay entradas en cache.</p>
                    @if (!isConnected)
                    {
                        <p class="text-muted small">Redis no está conectado. Los datos de cache no están disponibles.</p>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Key</th>
                                <th>Tipo</th>
                                <th>TTL</th>
                                <th>Tamaño</th>
                                <th>Hits</th>
                                <th>Misses</th>
                                <th>Hit Rate</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.OrderBy(e => e.Key))
                            {
                                var entryHitRate = entry.Hits + entry.Misses > 0
                                    ? (entry.Hits * 100.0 / (entry.Hits + entry.Misses)).ToString("F0")
                                    : null;
                                <tr>
                                    <td><code class="small">@entry.Key</code></td>
                                    <td><span class="badge bg-secondary">@entry.Prefix</span></td>
                                    <td>
                                        @if (entry.Ttl == TimeSpan.Zero)
                                        {
                                            <span class="text-muted">Persistente</span>
                                        }
                                        else if (entry.Ttl.TotalHours >= 1)
                                        {
                                            @($"{entry.Ttl.TotalHours:F1}")<text>h</text>
                                        }
                                        else if (entry.Ttl.TotalMinutes >= 1)
                                        {
                                            @($"{entry.Ttl.TotalMinutes:F0}")<text>m</text>
                                        }
                                        else
                                        {
                                            @($"{entry.Ttl.TotalSeconds:F0}")<text>s</text>
                                        }
                                    </td>
                                    <td>
                                        @if (entry.SizeBytes >= 1024)
                                        {
                                            @($"{entry.SizeBytes / 1024.0:F1}")<text> KB</text>
                                        }
                                        else
                                        {
                                            @entry.SizeBytes<text> bytes</text>
                                        }
                                    </td>
                                    <td><span class="text-success fw-medium">@entry.Hits</span></td>
                                    <td><span class="text-danger fw-medium">@entry.Misses</span></td>
                                    <td>
                                        @if (entryHitRate != null)
                                        {
                                            var rate = double.Parse(entryHitRate);
                                            <span class="fw-medium @(rate > 80 ? "text-success" : rate > 50 ? "text-warning" : "text-danger")">
                                                @($"{rate:F0}%")
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="text-muted">-</span>
                                        }
                                    </td>
                                    <td>
                                        <form asp-action="ClearCache" asp-controller="Administration" method="post"
                                              onsubmit="return confirm('Borrar cache key @entry.Key?')" class="d-inline">
                                            <input type="hidden" name="key" value="@entry.Key" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm" title="Borrar key">
                                                <i class="bi bi-trash3"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>
