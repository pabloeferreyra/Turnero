@model List<HealthCheckResult>
@{
    ViewData["Title"] = "Health Check";
    var overallStatus = ViewBag.OverallStatus as string ?? "unhealthy";
    var checkedAt = ViewBag.CheckedAt as DateTime? ?? DateTime.UtcNow;
    var isHealthy = overallStatus == "healthy";
    var healthyCount = Model?.Count(c => c.Status == "healthy") ?? 0;
    var totalServices = Model?.Count ?? 0;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="mb-0">
            <i class="bi bi-heart-pulse me-2"></i>Estado del Sistema
        </h1>
        <a href="@Url.Action("Health")" class="btn btn-outline-secondary btn-sm">
            <i class="bi bi-arrow-clockwise me-1"></i>Recargar
        </a>
    </div>

    @* Overall status banner *@
    <div class="alert @(isHealthy ? "alert-success" : "alert-danger") d-flex align-items-center gap-3 border-0 shadow-sm mb-4" role="alert">
        <div class="fs-1">
            <i class="bi @(isHealthy ? "bi-check-circle-fill" : "bi-exclamation-triangle-fill")"></i>
        </div>
        <div>
            <strong class="fs-5">@(isHealthy ? "Todos los servicios funcionando correctamente" : "Hay servicios con problemas")</strong><br>
            <span class="small opacity-75">
                @healthyCount de @totalServices servicios saludables &middot; Última verificación: @checkedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss")
            </span>
        </div>
    </div>

    @* Service cards *@
    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
        @foreach (var check in Model)
        {
            var isServiceHealthy = check.Status == "healthy";
            <div class="col-md-6 col-lg-4">
                <div class="card border-0 shadow-sm h-100 @(isServiceHealthy ? "" : "border-start border-danger border-4")">
                    <div class="card-body">
                        <div class="d-flex align-items-start gap-3">
                            <div class="fs-1 @(isServiceHealthy ? "text-success" : "text-danger")">
                                <i class="bi @check.Icon"></i>
                            </div>
                            <div class="flex-grow-1">
                                <h5 class="card-title mb-1">@check.Name</h5>
                                <span class="badge @(isServiceHealthy ? "bg-success" : "bg-danger") small px-2 py-1">
                                    <i class="bi @(isServiceHealthy ? "bi-check-circle" : "bi-x-circle") me-1"></i>
                                    @(isServiceHealthy ? "Saludable" : "No disponible")
                                </span>
                                <p class="card-text text-muted small mt-2 mb-0">
                                    @check.Description
                                </p>
                            </div>
                        </div>
                    </div>
                    @if (isServiceHealthy)
                    {
                        <div class="card-footer bg-transparent border-0 pt-0 px-3 pb-3">
                            <div class="d-flex align-items-center gap-2 text-success small">
                                <span class="spinner-grow spinner-grow-sm" role="status"></span>
                                Respondiendo correctamente
                            </div>
                        </div>
                    }
                </div>
            </div>
        }
    </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="bi bi-inbox fs-1 text-muted"></i>
            <p class="text-muted mt-2 mb-0">No hay servicios para verificar.</p>
        </div>
    }

    @* Quick links *@
    <div class="row g-3 mt-2">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 text-primary">
                        <i class="bi bi-database-gear"></i>
                    </div>
                    <div>
                        <h6 class="mb-1">Estado del Cache</h6>
                        <p class="text-muted small mb-0">Ver métricas detalladas de Redis y cache keys</p>
                        <a asp-action="CacheStats" asp-controller="Administration" class="btn btn-outline-primary btn-sm mt-2">
                            <i class="bi bi-arrow-right me-1"></i>Ir al Cache
                        </a>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-6">
            <div class="card border-0 shadow-sm">
                <div class="card-body d-flex align-items-center gap-3">
                    <div class="fs-2 text-primary">
                        <i class="bi bi-activity"></i>
                    </div>
                    <div>
                        <h6 class="mb-1">Endpoint /health</h6>
                        <p class="text-muted small mb-0">Respuesta JSON del endpoint usado por Docker healthcheck</p>
                        <code class="small">GET /health</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
