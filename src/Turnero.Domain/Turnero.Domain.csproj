<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Turnero.Domain: núcleo del negocio. Sin referencia a otros proyectos.
    El único paquete permitido es Relational (atributos como [Precision] que
    describen el modelo persistido sin arrastrar EF Core completo ni ASP.NET).
  -->

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.12" />
  </ItemGroup>

</Project>
