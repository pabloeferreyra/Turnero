@model List<TimeTurn>
@{
    ViewData["Title"] = "Horarios";
}

<div class="container-fluid management-page">
    <div class="agenda-toolbar mb-3">
        <a asp-action="Create" class="btn btn-primary">Nuevo horario</a>
    </div>
    <div class="agenda-heading">
        <div>
            <span class="agenda-heading__eyebrow">Administración</span>
            <h1>Horarios</h1>
        </div>
        <span class="agenda-count">@Model.Count @(Model.Count == 1 ? "horario" : "horarios")</span>
    </div>

    @if (Model.Count > 0)
    {
        <div class="management-list">
            @foreach (var item in Model)
            {
                <div class="management-item">
                    <div class="management-item__identity">
                        <span class="agenda-card__time">@Html.DisplayFor(modelItem => item.Time)</span>
                    </div>
                    <div class="management-item__actions">
                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Eliminar</a>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="agenda-empty">
            <i class="bi bi-clock" aria-hidden="true"></i>
            <strong>No hay horarios registrados</strong>
            <span>Agregá un horario para comenzar.</span>
        </div>
    }
</div>
