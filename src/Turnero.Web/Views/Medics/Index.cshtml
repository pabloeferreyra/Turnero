@model IEnumerable<Medic>
@{
    ViewData["Title"] = "Médicos";
    var medics = Model.ToList();
}

<div class="container-fluid management-page">
    <div class="agenda-toolbar mb-3">
        <a asp-action="Create" class="btn btn-primary">Nuevo médico</a>
    </div>
    <div class="agenda-heading">
        <div>
            <span class="agenda-heading__eyebrow">Administración</span>
            <h1>Médicos</h1>
        </div>
        <span class="agenda-count">@medics.Count @(medics.Count == 1 ? "médico" : "médicos")</span>
    </div>

    @if (medics.Count > 0)
    {
        <div class="management-list">
            @foreach (var medic in medics)
            {
                <div class="management-item">
                    <div class="management-item__identity">
                        <div class="agenda-card__name">@medic.Name</div>
                        <div class="agenda-card__details">ID: @medic.Id</div>
                    </div>
                    <form asp-action="Delete" asp-route-id="@medic.Id" method="post" class="management-item__actions">
                        <a asp-action="Edit" asp-controller="Medics" asp-route-id="@medic.Id" class="btn btn-outline-primary">Editar</a>
                        <span id="deleteSpan_@medic.Id">
                            <button type="button" class="btn btn-danger" onclick="confirmDelete('@medic.Id', true)">Eliminar</button>
                        </span>
                        <span id="confirmDeleteSpan_@medic.Id" style="display:none">
                            <span>¿Seguro que querés eliminar este médico?</span>
                            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                            <button type="button" class="btn btn-outline-primary" onclick="confirmDelete('@medic.Id', false)">Cancelar</button>
                        </span>
                    </form>
                </div>
            }
        </div>
    }
    else
    {
        <div class="agenda-empty">
            <i class="bi bi-person-badge" aria-hidden="true"></i>
            <strong>No hay médicos registrados</strong>
            <span>Agregá un médico para comenzar.</span>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/Medics.js"></script>
}
