@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityRole>
@{
    ViewData["Title"] = "Roles";
    var roles = Model.ToList();
}

<div class="container-fluid management-page">
    <div class="agenda-toolbar mb-3">
        <a asp-area="" asp-controller="Administration" asp-action="CreateRole" class="btn btn-primary">Nuevo rol</a>
    </div>
    <div class="agenda-heading">
        <div>
            <span class="agenda-heading__eyebrow">Administración</span>
            <h1>Roles</h1>
        </div>
        <span class="agenda-count">@roles.Count @(roles.Count == 1 ? "rol" : "roles")</span>
    </div>

    @if (roles.Count > 0)
    {
        <div class="management-list">
            @foreach (var role in roles)
            {
                <div class="management-item">
                    <div class="management-item__identity">
                        <div class="agenda-card__name">@role.Name</div>
                        <div class="agenda-card__details">ID: @role.Id</div>
                    </div>
                    <form asp-action="DeleteRole" asp-route-id="@role.Id" method="post" class="management-item__actions">
                        <a asp-action="EditRole" asp-controller="Administration" asp-route-id="@role.Id" class="btn btn-outline-primary">Editar</a>
                        <span id="deleteSpan_@role.Id">
                            <button type="button" class="btn btn-danger" onclick="confirmDelete('@role.Id', true)">Eliminar</button>
                        </span>
                        <span id="confirmDeleteSpan_@role.Id" style="display:none">
                            <span>¿Seguro que querés eliminar este rol?</span>
                            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                            <button type="button" class="btn btn-outline-primary" onclick="confirmDelete('@role.Id', false)">Cancelar</button>
                        </span>
                    </form>
                </div>
            }
        </div>
    }
    else
    {
        <div class="agenda-empty">
            <i class="bi bi-shield-lock" aria-hidden="true"></i>
            <strong>No hay roles registrados</strong>
            <span>Agregá un rol para comenzar.</span>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/Users.js"></script>
}
