@using Microsoft.AspNetCore.Identity
@model IEnumerable<IdentityUser>
@{
    ViewData["Title"] = "Usuarios";
    var users = Model.ToList();
}

<div class="container-fluid management-page">
    <div class="agenda-toolbar mb-3">
        <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-primary">Nuevo usuario</a>
    </div>
    <div class="agenda-heading">
        <div>
            <span class="agenda-heading__eyebrow">Administración</span>
            <h1>Usuarios</h1>
        </div>
        <span class="agenda-count">@users.Count @(users.Count == 1 ? "usuario" : "usuarios")</span>
    </div>

    @if (users.Count > 0)
    {
        <div class="management-list">
            @foreach (var user in users)
            {
                <div class="management-item">
                    <div class="management-item__identity">
                        <div class="agenda-card__name">@user.UserName</div>
                        <div class="agenda-card__details">ID: @user.Id</div>
                    </div>
                    <form asp-action="DeleteUser" asp-route-id="@user.Id" method="post" class="management-item__actions">
                        <a asp-action="EditUser" asp-controller="Administration" asp-route-id="@user.Id" class="btn btn-outline-primary">Editar</a>
                        <span id="deleteSpan_@user.Id">
                            <button type="button" class="btn btn-danger" onclick="confirmDelete('@user.Id', true)">Eliminar</button>
                        </span>
                        <span id="confirmDeleteSpan_@user.Id" style="display:none">
                            <span>¿Seguro que querés eliminar este usuario?</span>
                            <button type="submit" class="btn btn-danger">Sí, eliminar</button>
                            <button type="button" class="btn btn-outline-primary" onclick="confirmDelete('@user.Id', false)">Cancelar</button>
                        </span>
                    </form>
                </div>
            }
        </div>
    }
    else
    {
        <div class="agenda-empty">
            <i class="bi bi-people" aria-hidden="true"></i>
            <strong>No hay usuarios registrados</strong>
            <span>Agregá un usuario para comenzar.</span>
        </div>
    }
</div>

@section Scripts {
    <script src="~/js/Users.js"></script>
}
