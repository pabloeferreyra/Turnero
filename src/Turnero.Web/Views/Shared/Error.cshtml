@model ErrorViewModel
@if (string.IsNullOrEmpty(Model?.ErrorTitle))
{
    <h3>
        An error occurred while processing your request.
        The support team is notified and we are working on the fix
    </h3>
    <h5>Please contact us on pabloeferreyra@gmail.com</h5>
}
else
{
    <h1 class="text-danger">@Model.ErrorTitle</h1>
    <h6 class="text-danger">@Model.ErrorMessage</h6>
}