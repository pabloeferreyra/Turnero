<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    Turnero.Application: casos de uso y lógica de negocio. Depende solo de
    Turnero.Domain y de abstracciones (interfaces). No conoce EF Core,
    Npgsql ni ASP.NET Core: las implementaciones viven en Infrastructure.
  -->

  <ItemGroup>
    <PackageReference Include="Mapster" Version="10.0.12" />
    <PackageReference Include="Mapster.DependencyInjection" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.12" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Turnero.Domain\Turnero.Domain.csproj" />
  </ItemGroup>

</Project>
