{
  "projectName": "Turnero",
  "version": "3.0.1",
  "framework": "net10.0",
  "description": "Medical appointment management system (turnero médico). Manages patients, appointments (turns), doctors (medics), clinical history (visits, allergies, vaccines, growth charts, etc.), and user authentication via Firebase + ASP.NET Identity.",
  "company": "PF Software",
  "packageProjectUrl": "turnero.dev.ar",

  "architecture": {
    "pattern": "Clean Architecture (3-layer)",
    "layers": [
      {
        "name": "Turnero.DAL",
        "type": "Class Library",
        "purpose": "Data Access Layer - Models, DbContext, Migrations",
        "nugetPackages": [
          "Microsoft.AspNetCore.Identity.EntityFrameworkCore 10.0.11",
          "Microsoft.EntityFrameworkCore.Design 10.0.11",
          "Npgsql.EntityFrameworkCore.PostgreSQL 10.0.3"
        ]
      },
      {
        "name": "Turnero.Utilities",
        "type": "Class Library",
        "purpose": "Shared utilities - Mapster config, date calculations, constants",
        "nugetPackages": ["Mapster 10.0.11"]
      },
      {
        "name": "Turnero.SL",
        "type": "Class Library",
        "purpose": "Service Layer - Business logic, repositories, caching, Firebase integration",
        "nugetPackages": [
          "FirebaseAdmin 3.6.0",
          "Mapster 10.0.11",
          "StackExchange.Redis 3.0.17",
          "Microsoft.Extensions.Hosting.Abstractions 10.0.0"
        ]
      },
      {
        "name": "Turnero (Web App)",
        "type": "ASP.NET Core MVC",
        "purpose": "Presentation layer - Controllers, Views, SignalR Hubs, JS frontend",
        "nugetPackages": [
          "ClosedXML 0.105.1 (Excel export)",
          "QuestPDF 2026.7.1 (PDF export)",
          "Microsoft.AspNetCore.Authentication.JwtBearer 10.0.10",
          "Microsoft.AspNetCore.Identity.UI 10.0.10",
          "Microsoft.Extensions.Hosting.WindowsServices 10.0.10",
          "Microsoft.VisualStudio.Azure.Containers.Tools.Targets 1.23.0"
        ]
      },
      {
        "name": "Turnero.Test",
        "type": "xUnit Test Project",
        "purpose": "Unit tests for services and repositories",
        "nugetPackages": [
          "Microsoft.NET.Test.Sdk 18.0.1",
          "Moq 4.20.72",
          "xunit 2.9.3",
          "xunit.runner.visualstudio 3.1.5"
        ]
      }
    ]
  },

  "dataFlowDiagrams": {
    "note": "Mermaid diagrams rendered in project-context.html under the 'Flujo de Datos' section. All diagrams use CDN mermaid@11 with custom theme (primary: #0d6efd, secondary: #e9ecef).",
    "diagrams": [
      {
        "id": 1,
        "title": "Creación de Turno (con Caché + SignalR)",
        "type": "sequenceDiagram",
        "participants": ["Navegador", "TurnsController", "TurnServices", "Redis Cache", "PostgreSQL", "SignalR Hub"],
        "flow": [
          "Browser POST /Turns/Create → TurnsController",
          "TurnsController → TurnServices.InsertTurn(turnDto)",
          "TurnServices → PostgreSQL: INSERT INTO Turns",
          "PostgreSQL -->> TurnServices: Turno creado ✅",
          "TurnServices -->> TurnsController: return Ok()",
          "TurnsController → Redis: InvalidateCache('turns:{date}:all')",
          "Redis -->> TurnsController: Cache invalidada ✅",
          "TurnsController → SignalR Hub: SendAsync('UpdateTableDirected', medicName, message, date)",
          "SignalR Hub -->> Browser: Notificación en tiempo real 📢"
        ],
        "description": "Muestra el flujo completo de creación de un turno: validación en controlador, inserción en DB, invalidación de caché Redis + notificación en tiempo real al médico vía SignalR."
      },
      {
        "id": 2,
        "title": "Lectura con Caché Two-Tier",
        "type": "sequenceDiagram",
        "participants": ["Instancia A (App)", "L1: IMemoryCache", "L2: Redis", "PostgreSQL"],
        "flow": [
          "App → L1: Get('allergies:{id}')",
          "ALT L1 hit: L1 -->> App: ✅ Datos desde memoria local",
          "ALT L1 miss: App → L2: GetAsync('allergies:{id}')",
          "  ALT L2 hit: L2 -->> App: ✅ Datos desde Redis → App popula L1",
          "  ALT L2 miss: App → DB: SELECT * → DB -->> App: ✅ Datos → App popula L1 + L2"
        ],
        "description": "Flujo de lectura con 3 niveles: L1 (IMemoryCache, ultra-rápido) → L2 (Redis, distribuido) → DB (PostgreSQL). Cada nivel evita la consulta al siguiente. Los datos se cachean en ambos niveles al cargar desde DB."
      },
      {
        "id": 3,
        "title": "Invalidación Cross-Instancia via Pub/Sub",
        "type": "sequenceDiagram",
        "participants": ["Instancia A (crea/edita dato)", "Redis", "Pub/Sub 'cache:invalidate'", "Instancia B", "L1: IMemoryCache B"],
        "flow": [
          "Instancia A → Redis: KeyDelete('medics')",
          "Instancia A → Pub/Sub: Publish('cache:invalidate', 'medics')",
          "Pub/Sub -->> Instancia B: 📩 Mensaje recibido",
          "Instancia B → L1 B: Remove('medics')",
          "L1 B -->> Instancia B: ✅ Cache local B limpiado"
        ],
        "description": "Cuando una instancia modifica datos, invalida Redis + publica un mensaje en el canal Pub/Sub 'cache:invalidate'. Todas las demás instancias reciben el mensaje (via CacheInvalidationHostedService) y limpian su IMemoryCache local, garantizando consistencia entre réplicas."
      },
      {
        "id": 4,
        "title": "Autenticación Híbrida (Firebase + Identity)",
        "type": "sequenceDiagram",
        "participants": ["Usuario", "Login.cshtml", "Firebase Auth", "App Web", "ASP.NET Identity"],
        "flow": [
          "Usuario → Login.cshtml: Ingresa credenciales",
          "Login.cshtml → Firebase: POST /signInWithPassword",
          "Firebase -->> Login.cshtml: ✅ idToken + localId",
          "Login.cshtml → App: POST /api/auth/login {idToken}",
          "App → Firebase: VerifyIdTokenAsync(idToken)",
          "Firebase -->> App: ✅ FirebaseToken (uid)",
          "App → Identity: FindByIdAsync(uid)",
          "ALT Usuario existe: Identity -->> App: ✅ IdentityUser existente",
          "ALT No existe: App → Identity: CreateAsync + AddToRoleAsync → Identity -->> App: ✅ Nuevo usuario",
          "App → Login.cshtml: HttpOnly cookie + redirect",
          "Login.cshtml -->> Usuario: ✅ Sesión iniciada"
        ],
        "description": "Autenticación híbrida: Firebase Auth verifica las credenciales externamente, luego ASP.NET Core Identity maneja la sesión local con cookies HttpOnly. Si el usuario no existe localmente, se crea automáticamente."
      },
      {
        "id": 5,
        "title": "Dashboard de Administración de Cache",
        "type": "sequenceDiagram",
        "participants": ["Admin", "AdministrationController", "Redis", "IMemoryCache", "Pub/Sub"],
        "flow": [
          "Admin → AdministrationController: GET /Administration/CacheStats",
          "AdministrationController → Redis: GetAllKeysAsync() (SCAN cursor)",
          "Redis -->> AdministrationController: keys + TTL + type + size",
          "AdministrationController → Redis: Stats (hits/misses por key prefix)",
          "Redis -->> AdministrationController: ConcurrentDictionary<prefix, CacheStats>",
          "AdministrationController -->> Admin: ✅ Dashboard con tarjetas + tabla de keys",
          "Admin → AdministrationController: POST ClearCache('medics')",
          "AdministrationController → Redis: KeyDelete('medics')",
          "AdministrationController → IMemoryCache: Remove('medics')",
          "AdministrationController → Pub/Sub: Publish('cache:invalidate', 'medics')",
          "Pub/Sub -->> Admin: ✅ Cache limpiado en todas las instancias"
        ],
        "description": "El admin puede ver el estado completo del cache: conexión Redis, total de keys, hits/misses, hit rate, y una tabla detallada por key. Puede limpiar keys individuales, lo que invalida Redis + memoria local + notifica a otras instancias vía Pub/Sub."
      },
      {
        "id": 6,
        "title": "Diagrama de Arquitectura General",
        "type": "graph TB (flowchart)",
        "subgraphs": [
          {
            "name": "Frontend (Navegador)",
            "components": ["Vistas Razor (Bootstrap 5 + jQuery)", "JS Modules (signalR.js, turn.js, patients.js...)", "DataTables Server-side"]
          },
          {
            "name": "Web App (ASP.NET Core MVC)",
            "components": ["18 Controladores MVC", "SignalR Hub (TurnsTableHub)", "Auth (Firebase + Identity + JWT)", "Export Excel/PDF"]
          },
          {
            "name": "Service Layer (Turnero.SL)",
            "components": ["Turn Services", "Patient Services", "Clinical Services (Allergies, Vaccines, GrowthChart, PermMed)", "History Services (ParentsData, PersonalBg, PerinatalBg, CongErrors)", "Cross-Cutting (Logger, Firebase, Redis Cache)"]
          },
          {
            "name": "Redis Cache",
            "components": ["L1: IMemoryCache (local, ultra-fast)", "L2: Redis (distribuido, JSON)", "Pub/Sub 'cache:invalidate'"]
          },
          {
            "name": "Data Access (Turnero.DAL)",
            "components": ["PostgreSQL (ApplicationDbContext)", "13 Modelos de entidad", "Identity Framework (Users + Roles)"]
          },
          {
            "name": "Utilities",
            "components": ["Mapster Config (Entity ↔ DTO)", "RolesConstants (Admin/Medico/Ingreso)", "DateCalculations (Edad, fechas)"]
          },
          {
            "name": "Tests (221)",
            "components": ["Service Tests", "Repository Tests", "Helper Tests"]
          }
        ],
        "connections": [
          "Frontend → Web App (HTTP / SignalR)",
          "Web App → Service Layer (DI)",
          "Service Layer → Redis Cache (Read/Write)",
          "Service Layer → DAL (CRUD)",
          "DAL → PostgreSQL (Npgsql)",
          "L1 → L2 (fallback cuando L1 miss)",
          "L2 → DB (persistencia cuando cache miss)",
          "Pub/Sub → L1 (invalida cross-instancia)"
        ],
        "description": "Diagrama de arquitectura completo con todas las capas, componentes y conexiones. Usa colores por capa y subgraphs anidados. Muestra el flujo de datos desde el frontend hasta la base de datos, pasando por los 3 niveles de cache."
      },
      {
        "id": 7,
        "title": "Diagrama de Infraestructura / Deployment (Podman Compose + Redis + PostgreSQL)",
        "type": "graph TB (infrastructure)",
        "subgraphs": [
          {
            "name": "Internet",
            "components": ["Navegador Web (Usuario)", "Firebase Auth (externo)"]
          },
          {
            "name": "Entorno de Desarrollo (Podman Compose)",
            "components": ["turnero-app (1 contenedor, :8080)", "redis:7-alpine (:6379)", "redis-commander UI (:8081)"]
          },
          {
            "name": "Entorno de Producción (Podman Compose)",
            "components": ["Ingress Load Balancer (APP_PUBLISHED_PORT:8080)", "Manager Node (Redis, 0.25 CPU/256MB)", "App Replicas (2 instancias, 0.50 CPU/768MB c/u)", "Secretos (.env + firebase.json montados como read-only)"]
          },
          {
            "name": "Servicios Externos",
            "components": ["PostgreSQL (base de datos externa al cluster)"]
          }
        ],
        "connections": [
          "Browser → Dev App (HTTP :8080)",
          "Dev App → Redis (:6379)",
          "Dev App → PostgreSQL (Npgsql :5432)",
          "Dev App → Firebase (REST API)",
          "Redis Commander → Redis (:6379)",
          "Browser → Load Balancer (HTTPS/HTTP)",
          "Load Balancer → App Replica 1 (Round Robin)",
          "Load Balancer → App Replica 2 (Round Robin)",
          "App Replicas → Redis (overlay network, :6379)",
          "App Replicas → PostgreSQL (:5432)",
          "App Replicas → Firebase (REST API)",
          "App Replicas → .env (volume mount read-only)",
          "App Replicas → firebase.json (secret mount)"
        ],
        "description": "Arquitectura de despliegue con Podman Compose para desarrollo y producción (una instancia de la app, PostgreSQL externo). Muestra los límites de recursos, healthchecks y montaje de credenciales."
      },
      {
        "id": 8,
        "title": "Diagrama Entidad-Relación (ER) de la Base de Datos",
        "type": "erDiagram",
        "entities": [
          "Patient",
          "Medic",
          "TimeTurn",
          "Turn",
          "Visit",
          "Allergies",
          "Vaccines",
          "GrowthChart",
          "PermMed",
          "ParentsData",
          "PersonalBackground",
          "PerinatalBackground",
          "CongErrors",
          "ContactInfo",
          "IdentityUser"
        ],
        "relationships": [
          "Patient ||--o{ Visit : tiene",
          "Patient ||--o{ Allergies : padece",
          "Patient ||--o{ Vaccines : recibe",
          "Patient ||--o{ GrowthChart : registra",
          "Patient ||--o{ PermMed : toma",
          "Patient ||--|| ParentsData : extiende (PK compartido)",
          "Patient ||--|| PersonalBackground : hereda (PK compartido)",
          "Patient ||--|| PerinatalBackground : hereda (PK compartido)",
          "Patient ||--|| CongErrors : presenta (PK compartido)",
          "Patient ||--|| ContactInfo : tiene",
          "Medic ||--o{ Turn : atiende",
          "Medic ||--o{ Visit : realiza",
          "TimeTurn ||--o{ Turn : define",
          "IdentityUser |o--o| Medic : asociado a",
          "Turn }o--|| Medic : asignado a",
          "Turn }o--|| TimeTurn : en horario",
          "Visit }o--|| Patient : pertenece a",
          "Visit }o--|| Medic : realizada por"
        ],
        "entityAttributes": {
          "Patient": ["guid Id PK", "string Name", "string Dni", "date BirthDate", "string SocialWork", "enum BloodType"],
          "Medic": ["guid Id PK", "string Name", "string UserGuid FK"],
          "Turn": ["guid Id PK", "guid MedicId FK", "guid TimeId FK", "date DateTurn", "string Name", "long Dni", "string Reason", "bool Accessed"],
          "Visit": ["guid Id PK", "guid PatientId FK", "guid MedicId FK", "date VisitDate", "string Diagnosis", "string Treatment"],
          "ParentsData": ["guid Id PK,FK", "string FatherName", "dateOnly FatherBirthDate", "string MotherName", "int BrothersCount"],
          "PersonalBackground": ["guid Id PK,FK", "bool Asthma", "bool Diabetes", "bool Surgeries", "string Other"],
          "PerinatalBackground": ["guid Id PK,FK", "int Feat", "int Delivery", "int Weight", "int GestAge"],
          "CongErrors": ["guid Id PK,FK", "bool CongHypothyroidism", "bool Phenylalanine", "bool Galactosemia", "string Other"],
          "ContactInfo": ["guid Id PK", "string Phone", "string Email", "string Address", "guid PatientId FK"]
        },
        "description": "Diagrama ER completo con las 15 entidades del modelo (13 de negocio + ContactInfo + IdentityUser). Patient como entidad central con 10 relaciones: 4 1:1 con PK compartido (ParentsData, PersonalBackground, PerinatalBackground, CongErrors) y 6 1:N (Visit, Allergies, Vaccines, GrowthChart, PermMed, ContactInfo). Turn se relaciona con Medic y TimeTurn pero NO directamente con Patient (usa Name/Dni desnormalizados). IdentityUser se asocia opcionalmente con Medic via UserGuid."
      }
    ]
  },

  "database": {
    "provider": "PostgreSQL (Npgsql)",
    "dbContext": "ApplicationDbContext (inherits IdentityDbContext)",
    "connectionStringKey": "ConnectionStrings:PostgresConnection",
    "models": {
      "IdentityEntity": "IdentityUser (ASP.NET Core Identity)",
      "patient": {
        "model": "Patient : BaseEntity",
        "properties": ["Id (Guid)", "Name", "Dni", "BirthDate (date)", "SocialWork", "AffiliateNumber", "BloodType (enum)", "ContactInfo (1:1)"],
        "childEntities": ["Turn (1:N)", "Visit (1:N)", "Parent = ParentsData (1:1)", "PersonalBackground (1:1)", "PerinatalBackground (1:1)", "Vaccines (1:N)", "Allergies (1:N)", "PermMed (1:N)", "GrowthChart (1:N)", "CongErrors (1:1)"],
        "dto": "PatientDTO"
      },
      "medic": {
        "model": "Medic",
        "properties": ["Id (Guid)", "Name", "UserGuid (links to IdentityUser)"],
        "dto": "MedicDto"
      },
      "turn": {
        "model": "Turn (appointment)",
        "properties": ["Id (Guid)", "Name", "Dni", "MedicId (FK)", "DateTurn (date)", "TimeId (FK -> TimeTurn)", "SocialWork", "Reason", "Accessed (bool)"],
        "dto": "TurnDTO (flattened with Time string, MedicName string, Date string)"
      },
      "timeTurn": {
        "model": "TimeTurn (time slots)",
        "properties": ["Id (Guid)", "Time (string like '08:00')"]
      },
      "visit": {
        "model": "Visit : BaseEntity",
        "properties": ["Id (Guid)", "VisitDate (date)", "Reason", "Diagnosis", "Treatment", "PatientId (FK)", "MedicId (FK)", "EvolutionNotes", "LabResults", "OtherStudies", "Observations"],
        "dto": "VisitDTO"
      },
      "allergies": {
        "model": "Allergies : BaseEntity",
        "properties": ["Id (Guid)", "Name", "PatientId (FK)", "Begin (DateOnly)", "End (DateOnly?)", "Description", "Severity (enum)", "Type (enum AllergyType)", "Occurrency (enum)", "Comments"]
      },
      "vaccines": {
        "model": "Vaccines : BaseEntity",
        "properties": ["Id (Guid)", "Description", "DateApplied (DateOnly?)", "PatientId (FK)"],
        "dto": "VaccinesDto (adds OtherDescription field)"
      },
      "growthChart": {
        "model": "GrowthChart : BaseEntity",
        "properties": ["Id (Guid)", "Age (decimal)", "Time (string)", "Weight (decimal)", "WPerc", "Height (decimal)", "HPerc", "HeadCircumference (decimal)", "HCPerc", "Bmi (decimal)", "PatientId (FK)"]
      },
      "permMed": {
        "model": "PermMed : BaseEntity (permanent medications)",
        "properties": ["Id (Guid)", "Description", "PatientId (FK)"]
      },
      "parentsData": {
        "model": "ParentsData : PatientFKEntity (shared PK with Patient)",
        "properties": ["Id (Guid = PatientId)", "FatherName", "FatherBirthDate (DateOnly)", "FatherBloodType (enum)", "FatherWork", "MotherName", "MotherBirthDate (DateOnly)", "MotherBloodType (enum)", "MotherWork", "BrothersCount (int)"]
      },
      "personalBackground": {
        "model": "PersonalBackground : PatientFKEntity (shared PK)",
        "properties": ["Id (Guid = PatientId)", "Asthma (bool)", "Allergy (bool)", "Diabetes (bool)", "Surgeries (bool)", "Other (string)", ... 12+ bool medical history flags]
      },
      "perinatalBackground": {
        "model": "PerinatalBackground : PatientFKEntity (shared PK)",
        "properties": ["Id (Guid = PatientId)", "Feat (int)", "Delivery (int)", "Cesarean (int)", "Abort (int)", "Weight (int)", "Height (int)", "CefPer (int)", "Apgar1 (int)", "Apgar5 (int)", "GestAge (int)", "Pathologies (string)", "CongErrors (string)"]
      },
      "congErrors": {
        "model": "CongErrors : PatientFKEntity (shared PK)",
        "properties": ["Id (Guid = PatientId)", "CongHypothyroidism (bool)", "ResultHypothyroidism", "Phenylalanine (bool)", "ResultPhenylalanine", "FQP (bool)", "ResultFQP", "Biotinidase (bool)", "ResultBiotinidase", "Galactosemia (bool)", "ResultGalactosemia", "OHP (bool)", "ResultOHP", "Other (string)"]
      },
      "contactInfo": {
        "model": "ContactInfo : BaseEntity",
        "properties": ["Id (Guid)", "Phone", "Email", "Address", "City", "PostalCode", "PatientId (FK)"]
      }
    },
    "enums": [
      "BloodType", "Severity (Ninguna-Fatal)", "AllergyType", "Occurrency", "VaccinesEnum (BCG, Sabin, HepatitisB, ...)"
    ],
    "baseClasses": {
      "BaseEntity": "abstract class with Id (Guid, DatabaseGeneratedOption.Identity)",
      "PatientFKEntity": "class with [Key] Id (Guid, shared PK with Patient via FK)"
    }
  },

  "controllers": {
    "baseController": {
      "name": "TurneroBaseController : Controller",
      "helpers": [
        "NotFoundError(entityType, id) -> sets ViewBag.ErrorMessage",
        "SetAntiforgeryToken() -> stores token in ViewData",
        "CheckMedic() -> returns current user's MedicId or null",
        "EnumToSelectList<TEnum>() -> converts enum to SelectList",
        "EnumNamesToSelectList<TEnum>() -> converts enum names to SelectList",
        "GetCachedMedicsAsync() -> cached medics list",
        "GetCachedTimeTurnsAsync() -> cached time turns list",
        "GetCachedPatientsAsync() -> cached patients list",
        "InvalidateCacheAsync(cacheKey) -> clears Redis + memory + Pub/Sub"
      ]
    },
    "controllers": [
      { "name": "HomeController", "route": "/", "auth": "Authenticated", "actions": ["Index (dashboard with today's turn counts)"], "dependencies": ["IGetTurnsServices"] },
      { "name": "TurnsController", "route": "/Turns", "auth": "Ingreso, Medico", "dependencies": ["IInsertTurnsServices", "IGetTurnsServices", "IGetTurnDTOServices", "IUpdateTurnsServices", "IGetMedicsServices", "IHubContext<TurnsTableHub>"], "actions": ["Index", "InitializeTurns (DataTables JSON)", "TurnListAsync", "Details", "Create (GET/POST)", "Accessed", "Edit (GET/PUT)", "Delete", "CheckTurn", "ExportExcel", "ExportPdf"] },
      { "name": "TurnsPublicController", "route": "/TurnsPublic", "auth": "Anonymous", "dependencies": ["IInsertTurnsServices", "IGetMedicsServices", "IHubContext<TurnsTableHub>"], "actions": ["Index", "Create (spontaneous turn)"] },
      { "name": "PatientsController", "route": "/Patients", "auth": "Medico", "dependencies": ["IInsertPatientService", "IGetPatientService", "IGetParentsDataService", "IUpdatePatientService"], "actions": ["Index", "InitializePatients", "Create (GET/POST)", "Details", "Edit (GET/PUT)", "Delete"] },
      { "name": "MedicsController", "route": "/Medics", "auth": "Admin", "dependencies": ["UserManager", "IGetMedicsServices", "IInsertMedicServices", "IUpdateMedicServices"], "actions": ["Index", "Details", "Create (GET/POST)", "Edit (GET/POST)", "Delete/DeleteConfirmed"] },
      { "name": "TimeTurnController", "route": "/TimeTurn", "auth": "Admin", "dependencies": ["IGetTimeTurnsServices", "IInsertTimeTurnServices", "IDeleteTimeTurnServices"], "actions": ["Index", "Create (GET/POST)", "Delete/DeleteConfirmed"] },

      { "name": "AdministrationController", "route": "/Administration", "auth": "Admin", "dependencies": ["RoleManager", "UserManager", "RedisCacheService", "IMemoryCache", "ILogger"], "actions": ["ListUsers", "EditUser", "DeleteUser", "ManageUserClaims", "ListRoles", "CreateRole", "EditRole", "DeleteRole", "EditUsersInRole", "CacheStats (GET)", "ClearCache (POST)"] },

      { "name": "VisitsController", "route": "/Visits", "auth": "Medico", "dependencies": ["IGetVisitService", "IInsertVisitService"], "actions": ["Details", "Create (GET/POST)", "Index", "InitializeVisits"] },
      { "name": "AllergiesController", "route": "/Allergies", "auth": "Medico", "dependencies": ["IInsertAllergiesServices", "IUpdateAllergiesServices", "IDeleteAllergiesServices", "IGetAllergiesServices"], "actions": ["Details", "Create (GET/POST)", "Index", "InitializeAllergies", "Edit (GET/POST)", "Delete"] },
      { "name": "VaccinesController", "route": "/Vaccines", "auth": "Medico", "dependencies": ["IGetVaccinesServices", "IUpdateVaccinesServices", "IInsertVaccinesServices", "IDeleteVacinesServices"], "actions": ["Index", "InitializeVaccines", "Create (GET/POST)", "Edit (GET/POST)", "Delete"] },
      { "name": "GrowthChartController", "route": "/GrowthChart", "auth": "Medico", "dependencies": ["IGetGrowthChartService", "IInsertGrowthChartService", "IUpdateGrowthChartService", "IDeleteGrowthChartService"], "actions": ["Index", "Initialize", "Create (GET/POST)", "Edit (GET/POST)", "Delete"] },
      { "name": "PermMedController", "route": "/PermMed", "auth": "Medico", "dependencies": ["IGetPermMedService", "IInsertPermMedService", "IDeletePermMedService"], "actions": ["Index", "Initialize", "Create (GET/POST)", "Delete"] },
      { "name": "ParentsDataController", "route": "/ParentsData", "auth": "Medico", "dependencies": ["IUpdateParentsDataService", "IDeleteParentsDataService", "IGetParentsDataService"], "actions": ["Index", "Edit (GET/PUT)", "Delete"] },
      { "name": "PersonalBackgroundController", "route": "/PersonalBackground", "auth": "Medico", "dependencies": ["IGetPersonalBackgroundService", "IUpdatePersonalBackgroundService"], "actions": ["Index", "Edit (GET/PUT)"] },
      { "name": "PerinatalBackgroundController", "route": "/PerinatalBackground", "auth": "Medico", "dependencies": ["IGetPerinatalBackgroundService", "IUpdatePerinatalBackgroundService"], "actions": ["Index", "Edit (GET/PUT)"] },
      { "name": "CongErrorController", "route": "/CongError", "auth": "Medico", "dependencies": ["IGetCongErrorService", "IUpdateCongErrorService"], "actions": ["Index", "Edit (GET/PUT)"] },
      { "name": "FirebaseController", "route": "/api/auth", "auth": "Anonymous", "purpose": "Firebase authentication endpoints (login, register, reset password)" },
      { "name": "VademecumController", "route": "/Vademecum", "purpose": "Drug/vademecum search" }
    ]
  },

  "services": {
    "serviceLayer": {
      "pattern": "Each feature has its own folder with interface + implementation, e.g. /Turnero.SL/Services/TurnsServices/",
      "registration": "All registered via builder.Services.AddScoped<IInterface, Implementation>() in Program.cs"
    },
    "serviceGroups": {
      "Turns": {
        "folder": "Turnero.SL/Services/TurnsServices/",
        "services": [
          { "interface": "IGetTurnsServices", "implementation": "GetTurnsServices", "deps": ["LoggerService", "ITurnRepository", "RedisCacheService", "IMemoryCache"], "description": "Get turns by date/medic (cached with Redis+MemoryCache two-tier), GetTurn by id, GetTurnDTO, Exists, CheckTurn" },
