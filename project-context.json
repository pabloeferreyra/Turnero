  "repositories": {
    "baseRepository": {
      "name": "RepositoryBase<T> : IRepositoryBase<T>",
      "constructor": "(ApplicationDbContext context, IMemoryCache cache, RedisCacheService redisCache)",
      "methods": [
        "FindAll() -> IQueryable<T> (AsNoTracking)",
        "FindByCondition(Expression) -> IQueryable<T>",
        "Create / CreateAsync / Update / UpdateAsync / Delete",
        "GetCachedData<TResult>(cacheKey, getDataFunc) -> List<TResult> (two-tier: L1 Memory -> L2 Redis -> DB)",
        "InvalidateCacheAsync(cacheKey) -> clears both caches + publishes Pub/Sub",
        "CallStoredProcedure(procedureName, parameters) -> List<T>",
        "CallStoredProcedureDTO(connectionString, query, parameters) -> IQueryable<T>"
      ],
      "cacheExpiryStrategy": {
        "medics": "1 hour",
        "timeTurns": "1 hour",
        "patients": "10 minutes",
        "default": "10 minutes"
      }
    },
    "repositoryInterfaces": {
      "listBased": "Each entity has its own interface (e.g. IAllergiesRepository) with entity-specific methods + cached methods",
      "note": "Custom repository interfaces do NOT extend IRepositoryBase<T>. They define only the specific methods needed."
    },
    "repositories": [
      { "entity": "Medic", "repo": "MedicRepository", "interface": "IMedicRepository", "cachedMethod": "GetCachedMedics() -> key 'medics'" },
      { "entity": "TimeTurn", "repo": "TimeTurnRepository", "interface": "ITimeTurnRepository", "cachedMethod": "GetCachedTimes() -> key 'timeTurns'" },
      { "entity": "Turn", "repo": "TurnsRepository", "interface": "ITurnRepository", "note": "Uses CallStoredProcedure('GetTurns', params) for list queries" },
      { "entity": "TurnDTO", "repo": "TurnDTORepository", "interface": "ITurnDTORepository", "note": "Uses CallStoredProcedureDTO only (TurnDTO is not a DbSet). FindAll/FindByCondition throw NotSupportedException." },
      { "entity": "Patient", "repo": "PatientRepository", "interface": "IPatientRepository", "cachedMethod": "GetCachedPatients() -> key 'patients'" },
      { "entity": "Allergies", "repo": "AllergiesRepository", "interface": "IAllergiesRepository", "cachedMethod": "GetCachedAllergiesByPatient(id) -> key 'allergies:{patientId}'" },
      { "entity": "Vaccines", "repo": "VaccinesRepository", "interface": "IVaccinesRepository", "cachedMethod": "GetCachedByPatientId(id) -> key 'vaccines:{patientId}'" },
      { "entity": "GrowthChart", "repo": "GrowthChartRepository", "interface": "IGrowthChartRepository", "cachedMethod": "GetCachedByPatientId(id) -> key 'growthCharts:{patientId}'" },
      { "entity": "PermMed", "repo": "PermMedRepository", "interface": "IPermMedRepository", "cachedMethod": "GetCachedByPatientId(id) -> key 'permMed:{patientId}'" },
      { "entity": "ParentsData", "repo": "ParentsDataRepository", "interface": "IParentsDataRepository", "note": "Single entity (shared PK). Cached via service layer with Redis+MemoryCache" },
      { "entity": "PersonalBackground", "repo": "PersonalBackgroundRepository", "interface": "IPersonalBackgroundRepository", "note": "Single entity (shared PK). Cached via service layer" },
      { "entity": "PerinatalBackground", "repo": "PerinatalBackgroundRepositroy", "interface": "IPerinatalBackgroundRepository", "note": "Single entity (shared PK). Cached via service layer" },
      { "entity": "CongErrors", "repo": "CongErrorsRepository", "interface": "ICongErrorsRepository", "note": "Single entity (shared PK). Cached via service layer" },
      { "entity": "Visit", "repo": "VisitRepository", "interface": "IVisitRepository", "note": "No caching (returns IQueryable<VisitDTO> for DataTables)" }
    ]
  },

  "cachingSystem": {
    "type": "Two-tier distributed cache",
    "tiers": {
      "L1": { "name": "IMemoryCache", "location": "In-process per instance", "speed": "Ultra-fast, no serialization", "scope": "Local to each app instance" },
      "L2": { "name": "Redis (StackExchange.Redis 3.0.17)", "location": "External Redis server", "serialization": "JSON (System.Text.Json, camelCase)", "scope": "Shared across all instances" }
    },
    "fallback": "If Redis unavailable, app operates with IMemoryCache only (graceful degradation via AbortOnConnectFail=false)",
    "crossInstanceInvalidation": "Redis Pub/Sub channel 'cache:invalidate'. When an instance clears a key, it publishes the key name. All other instances receive the message and clear their local IMemoryCache.",
    "cacheKeys": {
      "medics": { "ttl_redis": "1 hour", "ttl_memory": "No expiry (explicit invalidation)", "type": "reference data" },
      "timeTurns": { "ttl_redis": "1 hour", "ttl_memory": "No expiry (explicit invalidation)", "type": "reference data" },
      "patients": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "reference data" },
      "turns:{date}:{medicId}": { "ttl_redis": "2 min", "ttl_memory": "30 sec", "type": "turn queries (DTO)" },
      "turnsList:{date}:{medicId}": { "ttl_redis": "2 min", "ttl_memory": "30 sec", "type": "turn queries (entity)" },
      "allergies:{patientId}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient clinical data" },
      "vaccines:{patientId}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient clinical data" },
      "growthCharts:{patientId}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient clinical data" },
      "permMed:{patientId}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient clinical data" },
      "parentsData:{id}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient single entity" },
      "personalBackground:{id}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient single entity" },
      "perinatalBackground:{id}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient single entity" },
      "congErrors:{id}": { "ttl_redis": "10 min", "ttl_memory": "No expiry (explicit invalidation)", "type": "patient single entity" }
    },
    "hitMissTracking": {
      "storage": "ConcurrentDictionary<string, CacheStats> in RedisCacheService (in-memory, resets on app restart)",
      "perKeyPrefix": "Stats are grouped by key prefix (e.g., 'medics', 'turns', 'allergies', etc.)",
      "viewableVia": "Admin dashboard at /Administration/CacheStats"
    },
    "statsEndpoint": {
      "controller": "AdministrationController",
      "actions": ["CacheStats (GET) - scans all Redis keys via SCAN, returns table with TTL/size/hits/misses", "ClearCache (POST) - removes specific key from Redis + local memory + publishes invalidation"],
      "view": "Views/Administration/CacheStats.cshtml",
      "navLink": "Administrar dropdown -> Cache"
    },
    "warmup": {
      "location": "Program.cs startup",
      "loadedKeys": ["medics", "timeTurns", "patients"],
      "failureBehavior": "Logs warning, continues with DB fallback"
    }
  },

